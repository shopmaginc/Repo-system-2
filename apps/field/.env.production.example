# Production build config for Cloudflare Pages.
# Copy to `.env.production` (or set as Pages environment variables) and fill in.
#
# The public URL of the API (Render free web service), e.g.:
#   https://repo-system-api.onrender.com
# The field app calls this directly — no same-origin proxy in production.
VITE_API_URL=https://YOUR-API.onrender.com
