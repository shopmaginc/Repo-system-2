# Copy to .env and fill in. NEVER commit a real .env.
DATABASE_URL="postgresql://repo:repo@localhost:5432/repo_system?schema=public"

# JWT signing secret — generate a long random value for any real deployment:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="dev-only-change-me-do-not-use-in-production"
JWT_ACCESS_TTL_SECONDS="900"

PORT="3000"

# Phase 3: photo intake. UPLOADS_DIR must be a non-web-served directory;
# stored files get random names (never user-supplied), and only
# image/PDF mimes are accepted. MAX_UPLOAD_MB caps each upload.
UPLOADS_DIR="./uploads"
MAX_UPLOAD_MB="25"

# File storage backend: "local" (dev default) or "s3" (S3-compatible,
# e.g. Cloudflare R2 — bucket stays private; downloads go through the
# authenticated API endpoints, never public URLs).
STORAGE_BACKEND="local"
# Required when STORAGE_BACKEND=s3:
# S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
# S3_BUCKET="repo-system-uploads"
# S3_ACCESS_KEY_ID="..."
# S3_SECRET_ACCESS_KEY="..."
# S3_REGION="auto"

# CORS: comma-separated allowlist for production (your Cloudflare Pages URL).
# Leave unset in dev (the API reflects the request origin).
# CORS_ORIGIN="https://repo-field.pages.dev"
